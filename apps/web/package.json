{
  "name": "@ipp/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../../contracts/openapi/registry.json -o src/shared/api/generated/registry.ts && openapi-typescript ../../contracts/openapi/permits.json -o src/shared/api/generated/permits.ts && openapi-typescript ../../contracts/openapi/eligibility.json -o src/shared/api/generated/eligibility.ts && openapi-typescript ../../contracts/openapi/enforcement.json -o src/shared/api/generated/enforcement.ts && openapi-typescript ../../contracts/openapi/audit.json -o src/shared/api/generated/audit.ts && openapi-typescript ../../contracts/openapi/policies.json -o src/shared/api/generated/policies.ts",
    "lint": "eslint src && stylelint \"src/**/*.scss\"",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "i18n:check": "node scripts/check-i18n.mjs",
    "verify": "npm run lint && npm run i18n:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/heebo": "5.1.1",
    "@fontsource/noto-sans": "5.1.1",
    "@fontsource/noto-sans-arabic": "5.1.1",
    "@hookform/resolvers": "3.9.1",
    "@tanstack/react-query": "5.62.7",
    "@tanstack/react-table": "8.20.6",
    "@tanstack/react-virtual": "3.11.2",
    "i18next": "24.2.0",
    "oidc-client-ts": "3.1.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.2",
    "react-i18next": "15.2.0",
    "react-router-dom": "6.28.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.10.2",
    "eslint": "9.17.0",
    "eslint-plugin-boundaries": "5.0.1",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.4.4",
    "sass": "1.83.0",
    "stylelint": "16.12.0",
    "stylelint-config-standard-scss": "14.0.0",
    "stylelint-use-logical": "2.1.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vite": "6.0.5",
    "vitest": "3.0.5"
  }
}
