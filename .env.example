# IPP – development defaults ONLY. Copy to .env (ipp up does it automatically).
# These are throwaway demo credentials for a local, offline stack. Never reuse them.
COMPOSE_PROJECT_NAME=ipp
COMPOSE_PARALLEL_LIMIT=2
COMPOSE_PROFILES=core

# registries (air-gapped: point to internal Nexus/Artifactory)
DOCKER_REGISTRY=docker.io
NPM_REGISTRY=https://registry.npmjs.org/
MAVEN_MIRROR_URL=https://repo.maven.apache.org/maven2

# postgres
POSTGRES_PASSWORD=dev_pg_admin
REGISTRY_DB_PASSWORD=dev_registry
PERMITS_DB_PASSWORD=dev_permits
ELIGIBILITY_DB_PASSWORD=dev_eligibility
ENFORCEMENT_DB_PASSWORD=dev_enforcement

# mongo
MONGO_ROOT_PASSWORD=dev_mongo

# keycloak admin console: http://localhost:8180/auth/admin
KEYCLOAK_ADMIN_PASSWORD=dev_kc_admin

# seaweedfs s3
S3_ACCESS_KEY=ipp_dev_access
S3_SECRET_KEY=ipp_dev_secret_change_me
