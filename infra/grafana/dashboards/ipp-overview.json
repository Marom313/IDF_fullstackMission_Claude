        },
        {
          "refId": "B",
          "expr": "max(ipp_eligibility_check_seconds{quantile=\"0.95\"}) * 1000",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "max(ipp_eligibility_check_seconds{quantile=\"0.99\"}) * 1000",
          "legendFormat": "p99"
        }
